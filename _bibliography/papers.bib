@article{tian2024gucheng,
  abbr={城市规划学刊},
  selected={true},
  title={“社会—空间”视角下古城“自更新”路径与模式探索——以米脂古城为例},
  english_title={Exploring the “Self-Renewal” Path and Model of Ancient Cities from a “Social–Spatial” Perspective: A Case Study of the Mizhi Ancient City},
  preview={tian2024gucheng.png},
  author={Darui Tian and Yuhang Wan†},
  chinese_authors={田达睿，<strong>万雨杭</strong><sup>†</sup>},
  journal={城市规划学刊},
  year={2024},
  number={06},
  pages={87--95},
  doi={10.16361/j.upf.202406012},
  html={https://link.cnki.net/doi/10.16361/j.upf.202406012},
  abstract={以古城为代表的“人居型遗存”始终是国际遗产保护的前沿研究阵地，也是与现代城市发展不断活态交融的复杂空间地域。当前古城保护在重视空间本体论与文旅再生产的范式下，对“社会—空间”互存共生的人地关系及居民权益考虑不足，亟待结合自组织实践探索古城可持续保护理论。借助“社会—空间”理论，研究提出古城“自更新”概念，以陕西省米脂古城的“在地复兴”为例，归纳出“需求触媒—功能扎根—空间互构—区域协作”为主线的“功能化社区型”古城更新路径，在此基础上揭示有别于国内一般古城文旅发展范式的“自更新”模式，为现阶段中小型古城实现历史空间再生产与个体单元再发展的共赢提供一定理论思考与借鉴。},
  annotation={† 通讯作者 / Corresponding author}
}

@mastersthesis{wan2025thesis,
  abbr={硕士论文},
  title={“社会—空间”视角下古城自更新路径与模式探索},
  english_title={Exploring the Self-Renewal Path and Model of Ancient Cities from a “Social–Spatial” Perspective},
  preview={wan2025thesis.png},
  author={Yuhang Wan},
  chinese_authors={<strong>万雨杭</strong>},
  school={西安建筑科技大学},
  year={2025},
  html={https://kns.cnki.net/kcms2/article/abstract?v=R4S5WDEiKctt_ZCVByh_CwdUrHVrqsI-D4MNt8YwT1IWf-Zvl8PsAu7L_Xscob9UHuwaqzT-zy8_PpltMjKghQdDkW4lZYbhBvMcusgCMAjfjQMUdgw1hMBNoTSZ6JiOmct7zEEJriFIm2QwRh2O8_AYyoPspMUV_deeXo_nbwfhO2e2W8AKSKwPcc-aH8T2UEuRO0CW2p0&uniplatform=NZKPT&captchaId=4621d60e-541f-4afc-849d-5b1924cd4c07},
  abstract={以古城为代表的人居型遗存，亟待结合自组织实践探索古城可持续保护与更新理论。研究内容涵盖以下三点：一是基于“社会—空间”视角结合自组织理论，提出古城“自更新”概念与其理论框架；二是以陕西省米脂古城为例展开实证，归纳“需求触媒—功能扎根—空间互构—区域协作”为主线的“功能化社区型”古城自更新路径；三是在理论建构与实证演绎的基础上，探索中小型古城实现“社会—空间”协同的自更新模式。未来我国的人居型古城，应更多鼓励自然发展，以“开放式吸纳—在地化培育”的协同机制促使古城焕活，通过内部“功能+社区”的柔性互构，得以与“古城—城市—区域”间的流要素进行联通，以此孕育出“社会—空间”互适的实践环境以提升现代人居价值，从而引导居民自涌现出一系列的更新行动。基于原真性的空间遗产与在地性的历史底蕴是古城本身价值所在，但古城的复兴亦离不开人的汇聚。古城居民能够安居乐业，方能体现古城更新的真正内涵。通过上述研究，希冀为现阶段人居型遗存实现历史空间再生产与个体单元再发展的共赢，提供一定的理论思考与案例借鉴。},
  note={硕士学位论文 · 导师：田达睿}
}

